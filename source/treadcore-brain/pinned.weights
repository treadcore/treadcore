# THE PINNED BRAIN (LAB-REPORT-BRAIN.md 147): the brain's defaults on 4 November 2026, main at
# 43f9f67, written down once for the unit tests. A test that plays the brain and asserts on what
# it did plays this one (`Settings::pinned()`), so a promotion that moves a default moves the game
# and not the tests; the defaults are the families' and the gauntlet's to judge.
#
# Nothing here changes when the defaults change. A weight added after this file plays its default
# until `write_the_pinned_brain` (weights.rs, ignored) adds its line at that default; that test
# never changes a line already here. To move the pinned brain itself is a lab report's decision.
caps = kite, dodge, bridges, rotate, forget, board, priced_crossing, column, cycle, island_site, escort, bridge_jobs, duck, posture, castle_cap, focus_blend
w_near = 2  # target: worth of nearness, w_near / (1 + d / near_scale)
near_scale = 30  # target: the distance scale of nearness, tiles
w_wounded = 1.2  # target: worth of its wounds
w_finish = 0.552896  # target: one direct shot from dead
w_boat = 2  # target: afloat, a boat sinks at one hit
w_called = 0.8  # target: a teammate pinged it
called_for = 15  # target: seconds a ping stays a call
w_focus = 0.5  # target: each teammate already on it
focus_cap = 2  # target: teammates on it before overkill (rounded)
w_overkill = 0.6  # target: off for each teammate past the cap
w_in_range = 1.4  # target: in direct range now
w_threat = 0.6  # target: menacing a teammate or the base
base_r = 4.48349  # target: the base's reach for w_threat, tiles
w_stick = 0.322391  # target: the one already chosen
w_shooter = 2  # target: the tank that last shot at this one, for ten seconds (LR 142, the gauntlet's G20)
focus_blend = 0.25  # target (LR 117): 0 the near tank in range, 1 the wounded one a teammate is on; 0.5 both as before (each side's terms doubled toward its end)
odds_r = 14  # odds: tanks this near the fight count, tiles
pillbox_worth = 0.7  # odds: a hostile pillbox as a share of a tank
strike_worth = 0.35  # odds: a hostile strike drone as a share of a tank
engage_odds = 0.353899  # odds: below these, with help coming, mass
press_odds = 1.33767  # odds: above these, close in
coming_r = 221.036  # odds: teammates this near are coming, tiles
mass_for = 12  # odds: seconds to hold off for them
answer_cap = 1.5176  # pings: this many nearer teammates answer instead (rounded)
crew_reach = 40  # pings: a crew on a job answers only this near, tiles
w_exposure = 0.605073  # stand: cost per gun covering a firing point
w_flank = 0.3  # stand: cost of leaving the flank's bearing
kite = 1  # kite: on (1) or off (0) (rounded)
kite_margin = 1.5  # kite: the waiting ring past the target's reach, tiles
kite_in = 2.25  # kite: the ring a step in ends on, tiles
kite_in_alone = 6  # kite: the ring a step in ends on with no friend inside `odds_r` of the target, tiles: alone, a shallow step in fires from near the target's reach and is out again before its gun is loaded; with friends, the step in closes (LR 145, the gauntlet's G21 and G22; Paul: "kite and dance, unless we have backup")
kite_turn = 0.8  # kite: seconds a step in takes beyond the drive
kite_spare = 0.4  # kite: seconds of the target's reload to spare
w_smooth = 0.05  # smooth: how much the bot smooths, 0 to 1. The move's desire vector and the retreat thresholds blend by it; the rung's and the turret's confirmation, the stance's advance scalar and resupply by the doctrine alone act above 0.5 (yes or no). 0 is the capability off, 1 on
alpha = 0.179532  # smooth: the move's desire vector, share of the new pull a think
beta = 0.652432  # smooth: the advance scalar, share of the new pull a think
margin = 0.15  # smooth: a challenger must beat the intent by this share
confirm = 2  # smooth: thinks in a row a challenger must win (rounded)
confirm_turret = 3  # smooth: picks in a row before the turret changes target (rounded)
commit = 0.1  # smooth: the intent's commitment bonus
advance_band = 0.652128  # smooth: the advance scalar presses above this and falls back below minus this
jitter = 3  # smooth: a moving goal's shift under this is smoothed, over it taken at once, tiles
retreat_armor = 50  # survival: armour at or under this goes home (blended from the constant by `w_smooth`, 0.05: at the defaults it barely acts, LR 86)
retreat_shells = 4  # survival: shells at or under this go home (blended from the constant 4 by `w_smooth`, 0.05: at the defaults it barely acts, LR 86)
forget_for = 120  # memory: seconds a given-up target stays given up
bridge_soft = 6  # crossing: a bridge this long or shorter costs no extra
k_long = 0.5  # crossing: the square cost of each tile past bridge_soft
c_boat = 5  # crossing: a boat's price in material
t_launch = 3  # crossing: the launch and the landing, in material
tree_material = 4  # crossing: material a tree gives
forest_need = 12  # island: trees a base will ask for
w_site_forest = 1  # island: a base site's worth of trees enough
w_site_small = 1  # island: a base site's cost of a small island
site_area = 400  # island: an island this large or larger is not small, tiles
site_poor = 0.5  # island: island_site moves the base off the nearest depot only when that depot's site scores under this (`site_score`, -1 to 1); 2 (before LR 73) always, so on a map of continents a slightly better site an ocean away won
site_reach = 30  # island: island_site's better site lies within this many tiles of the nearest depot; 1000 (before LR 73) anywhere, and on atlantic and europe the bases went 70 to 275 tiles off
w_site_beach = 20  # island: tiles of a boat's run a beach's island is worth per point of its site score (`site_score`, -1 a small bare islet to 1 a large forested island), while the side holds no depot (a naval start); 0 (before LR 62) the beach by its run and danger alone; needs island_site
column_gap = 2  # column: tiles between tanks in file on a bridge
column_past = 2  # column: the wedge comes back this far past the bridge, tiles
swap_gap = 0.207136  # rotation: readiness gap between a hot and a cold point that swaps two tanks
bot_style = 0  # brain: which named style a team plays, read when its bots are made, so a match's next (choice: fleet | raider | castle | expander | timid | overrider | scholar | duelist | rome | china | mongolia | shoshone | venice | japan | polynesia | assyria | quartermaster | gladiator): styles.rs; 8 to 15 are the personas of 2 November, 16 the learned tank with its squad, 17 the Duelist with a world champion
bot_mix = 0  # brain: how many seats of a census's trial team play its bot_style, the rest the rules (choice: all | one | two | half): the style goes to the team's last seats, so the leader and the guard that build the base stay the rules (LR 134: a mixed team, two of the rules and one Quartermaster, so its ore has a smelter to go to)
model = 0  # brain: a team's brain, 0 the rules, k a learned model in the fleet's slot k (choice: rules | slot1 | slot2 | slot3 | slot4 | slot5 | slot6 | slot7): the census reads CENSUS_MODELS/k.bin, orrery names each slot by its generation (models.tsv)
roles = 0  # team: a bots' team of five after its leader (choice: as_built | no_guard | two_guards | three_guards): as built a guard, two rangers and a wing; no guard sends the guard out with the fleet; two and three guards keep more at the base (fleet::MIXES)
ping_style = 0  # pings: what a team calls and answers (choice: as_built | help | warn | defend | all): as built the switch `pings` decides and every call is help; help calls for help when outnumbered and comes when called; warn warns off and takes warnings and cautions; defend calls and comes only for a base under attack; all of them, and it says what it saw
ping_help_reach = 60  # pings: a call for help is answered this near, tiles
ping_defend_reach = 90  # pings: a call to defend is answered this near, tiles
ping_defend_hold = 1.5  # pings: a defence is held this many times as long as a rally
ping_warn_reach = 25  # pings: a warning moves a tank this near it, tiles
ping_warn_flee = 15  # pings: a warned tank moves this far away, tiles
ping_caution_reach = 20  # pings: a rally this near a caution is dropped, tiles
ping_outnumbered = 1.5  # pings: hostile tanks over ours by this ratio is a call for help
home_pick = 1  # resupply: which base a tank goes home to (choice: nearest | stocked): stocked by shells over the road, front.rs; a depot's store can run dry, so the nearest may be empty
advance_plan = 1  # advance: after taking a pillbox or base (choice: as_built | forward): forward calls for help, chains it, drags it on, cuts wood and lays road back
mine_plan = 1  # mines: where a squad lays them (choice: as_built | line | raid): as built on the base's approach; line across the battle line's road, front.rs; raid that, and a tank inside an enemy base lays one and runs home
bio = 0  # intuition: the shape of a tank's slow waves (choice: off | sine | triangle | square | saw): bio.rs
bio_period = 60  # intuition: the first wave's period, seconds; the others run 28/23 and 33/23 as long
bio_amount = 0.25  # intuition: how far the waves swing how bold a tank is, a share of engage_odds
patch = 0  # patch: a learned transform over the rules' Move (choice: off | slot1 | slot2 | slot3 | slot4 | slot5 | slot6 | slot7): patch.rs, CENSUS_PATCHES/k.bin
patch_confidence = 0.5  # patch: it overrides the rules only at this confidence or more
patch_reach = 10  # patch: at full output it moves the rules' point this far, tiles
duel_gate = 0  # duel: crucible's champion takes the fight only when its confidence is over this (styles 7 and 17, LR 140): 0 is the champion's own gate, higher keeps it to the fights it is sure of
ladder = 0  # auto: the ladder's order, defend base first in each (choice: as_built | expand_before_hunt | hunt_first | expand_first): as built, fortify, turrets, hunt, expand, guard (Rung::order)
w_posture = 0.95  # posture: the team's posture against the ladder's fixed order, 0 the order alone; a leaned rung climbs past fewer than 5 w / (1 - w) rungs above it, so from 0.5 the posture decides among the rungs that hold (LR 24)
posture_scored = 1  # posture: the five scores (1) against the threshold ladder of 12e (0), each posture's worth the blend of the two (LR 25)
w_pos_defend = 3  # posture: worth of Defend's score, hostile worth within the base's alarm, half a tank full
w_pos_economy = 1  # posture: worth of Economy's score, the team's material spent, or a starved plan
w_pos_fortify = 0.046875  # posture: worth of Fortify's score, the share of the castle not yet built
w_pos_connect = 1  # posture: worth of Connect's score, the share of pillbox slots and road posts still empty
w_defend_ground = 3  # posture: hostile worth on our held ground (the board's territory of pillboxes and depots alone) beyond the base's alarm, counted toward Defend at this share, as the base's own threat is (LR 68); 0 the base alone (LR 24)
connect_idle = 1  # posture: how much of Connect's score stands when this tank has no pillbox to bring in: 1 as built, 0 a score only for work that can be done
w_pos_expand = 0.4  # posture: worth of Expand's score, the team's odds against what it sees, 1 at press_odds
dodge_horizon = 1.08151  # dodge: seconds before a shell lands that the tank starts out from under it
dodge_margin = 0.8  # dodge: tiles past the splash a shell's landing still counts as on the tank
dodge_clear = 2.5  # dodge: tiles past the splash the tank drives to, across the shell's line
dodge_hold = 0  # dodge: the share of the shell's flight the tank stays out, arrived or not (1), against only while it drives (0, before LR 27)
dodge_release = 1  # dodge: once at its point before the shell lands, an errand that would drive the tank back into the splash waits (1, the default since LR 54, Paul's choice), against every errand at once (0, before LR 53); thresholded at 0.5
dodge_every = 1  # dodge: the plan and the release against every hostile shell landing within the horizon, each at its own landing (1, LR 56), against the one shell dodged (0, LR 53); thresholded at 0.5
dodge_fire = 1  # dodge: with a hostile shell landing within the horizon, a shot whose turn of the hull (a tank has no turret) would carry the tank into the splash waits (1, LR 57), against the guns free (0); thresholded at 0.5
dodge_own_route = 1  # dodge: the forecast of a drive (`drive_path`) ashore to where the tank is already going follows the tank's own route, the one the world will drive, with no search (1, the default since LR 93: a census faster, the same play within the noise; afloat it searches), against a route searched afresh every tick under fire (0, before LR 93); thresholded at 0.5
dodge_plan = 1  # dodge: the point by where the tank's own turn and speed will have it when the shell lands (1, the default since LR 54, Paul's choice), against across the shell's line always (0, before LR 53); thresholded at 0.5
landfall_shy = 1  # landfall: at 1, each tile of a boat's run in a hostile gun's reach costs as much as 4 tiles more to sail; 0 (before LR 38) prices only the beach and the heading
landfall_wait = 10  # landfall: seconds of a crossing a boat stands off a beach a seen hostile tank covers, out of its reach, before it lands anyway; 0 (before LR 38) lands at once
landfall_memory = 30  # landfall: seconds a hostile tank out of sight is kept where it was last seen, for the beach, the run and the stand-off; 0 (before LR 38) keeps none
w_give_item = 1  # cycle: one plan item for the base on each fill
w_give_upgrade = 1  # cycle: one improvement for the base on each fill
w_connect = 1  # cycle: road tiles toward the next friendly base or pillbox
connect_tiles = 5.12027  # cycle: road tiles laid on one visit at most
w_mend = 0.5  # improvement: worth of mending the most hurt pillbox of the base
w_mine = 0.860887  # improvement: worth of a mine on the moat
w_works = 0.5  # improvement: worth of works on a pad by the base
ore_low = 10  # ore (game 6): a crew fetches ore when the side's nearest depot holds fewer shells than this; 0 never
ore_reach = 40  # ore (game 6): a deposit within this of the base is worth a smelter and a run, tiles
oil_low = 4  # oil (game 7): a crew fetches oil when the side's refinery holds less than this; 0 never
city_plan = 3  # city (game 7): how far the base's guard builds the city when quiet (choice: none | camp | town | works | city): a camp is the castle and the cycle; a town adds a harvester; the works the stores, the road to the smelter and a refinery; the city a data centre and a workshop
w_up_stores = 1  # city (game 7): worth of the depot's stores at 60 supply; 0 never buys
skill = 1  # skill: how well a bot plays (PLAYABILITY item 9, LR 67), 1 in full, 0 a rookie's: the aim off by (1 - skill) of a rookie's scatter and the lead taken by skill; under 0.5 no dodge, kite or storm and one interceptor on station; drones held (1 - skill) of a rookie's 90 s; a plain RuleBot thinks every quarter to half second
upgrade_vs_mend = 0.5  # improvement: share of the slot for 11g's upgrades once they exist, against mend, mines and works
castle_inside = 2  # castle: pillboxes inside the wall, then it stops filling (rounded)
castle_road = 2  # castle: pillboxes outside on its road (rounded)
post_spacing = 31.8699  # posts: tiles between pillboxes on a road between bases
posts_max = 6  # posts: road posts a base fills at most (rounded)
junction_clear = 3  # posts: no post this near a road junction, tiles
connect_bases = 0.75  # connect: a base or castle preferred to a lone pillbox, 0 none, 1 its distance counted at nothing
bridge_keep = 90  # bridge jobs: seconds a part-laid bridge stays on the team board with no tile laid
bridge_reach = 40  # bridge jobs: a teammate this near its next tile takes it, tiles
bridge_wing = 1  # bridge jobs: a wingman with material takes one too, leaving its leader's wedge (1), or only tanks on auto (0) (rounded)
w_duck = 1  # duck: safety against the errand; a tank ducks with its armour share at or under this, 1 always, 0 never
duck_memory = 2.5  # duck: seconds a hostile gun seen is remembered where it was, its reload counted down (sight and direct range are both 10 tiles, so a gun at the edge is often unseen)
duck_plan = 1  # duck: the point held while it stays safe, else the one `drive_to` has out of the gun's reach or line by the tick it is ready (1, LR 57), against the nearest safe point to the errand, picked anew each think (0, LR 21); thresholded at 0.5
duck_ready = 1.5  # duck: a hostile gun ready within this many seconds threatens, if it fires before mine (a tank covers about five tiles in 1.5 s)
w_front = 0  # front (0, the default since LR 75): Expand's depot by its distance to the team board's front (1, LR 58) against its distance to the base (0, before LR 58), the cost the blend of the two; a depot so chosen is kept until taken or given up; needs board
w_front_post = 0  # front (0, the default since LR 75): the guard's post moved this share of the way toward the nearest front sector (1, LR 61), `FRONT_POST_REACH` tiles at most, against the post at the base (0, before LR 61); a guard on rotation leaves its post, so it acts only with a raider at the base; needs board
w_front_push = 0  # front (0, the default since LR 75): the rotation's push point moved this share of the way toward the front sector nearest it (1, LR 61), against halfway to the side's objective (0, before LR 61); needs board
front_memory = 30  # front: seconds a hostile tank out of sight still counts toward the board's front where it was last seen; 0 (before LR 58) counts only what is in sight
fetch_gather = 20  # escort: a fetch trip farther than this from the base gathers the fleet first, tiles
long_game = 0.5  # score: 0 judges the win and kills, 1 the ground held over time
shell_boxes = 1  # spending (LR 86, the cowboy, the default since): 1 shells a hostile pillbox in the indirect gun's reach whenever the gun is ready and no tank is shot at, 0 only those guarding a stormed depot (before LR 86); thresholded at 0.5
longshot_every = 1.25  # spending: seconds between a tank's longshots (5 since LR 86, 30 before)
longshot_any = 1  # spending (1 since LR 86): 1 a longshot with no hostile structure to hit goes at the nearest hostile pillbox, else the target tank; 0 at structures only (before LR 86); thresholded at 0.5
strikes_max = 3.30238  # spending: a tank's strike drones out at once (3 since LR 86, 1 before, rounded)
assist = 1  # roles: a person's team gets a builder at 0.5 and over, else is dealt as a bots' team
temper_engage_1 = 0  # temper: how much the 60 s wave moves engage_odds, the bar under which a tank holds off, a share of it; bio.rs
temper_engage_2 = 0  # temper: how much the 73 s wave moves engage_odds, the bar under which a tank holds off, a share of it; bio.rs
temper_engage_3 = 0  # temper: how much the 86 s wave moves engage_odds, the bar under which a tank holds off, a share of it; bio.rs
temper_press_1 = 0  # temper: how much the 60 s wave moves press_odds, the bar over which it closes, a share of it; bio.rs
temper_press_2 = 0  # temper: how much the 73 s wave moves press_odds, the bar over which it closes, a share of it; bio.rs
temper_press_3 = 0  # temper: how much the 86 s wave moves press_odds, the bar over which it closes, a share of it; bio.rs
temper_retreat_1 = 0  # temper: how much the 60 s wave moves retreat_armor, the armour it goes home at, a share of it; bio.rs
temper_retreat_2 = 0  # temper: how much the 73 s wave moves retreat_armor, the armour it goes home at, a share of it; bio.rs
temper_retreat_3 = 0  # temper: how much the 86 s wave moves retreat_armor, the armour it goes home at, a share of it; bio.rs
temper_trigger_1 = 0  # temper: how much the 60 s wave moves longshot_every, the seconds between its longshots, a share of it; bio.rs
temper_trigger_2 = 0  # temper: how much the 73 s wave moves longshot_every, the seconds between its longshots, a share of it; bio.rs
temper_trigger_3 = 0  # temper: how much the 86 s wave moves longshot_every, the seconds between its longshots, a share of it; bio.rs
crew_stay = 1  # crew: who keeps building while the castle is unfinished, whatever the leader does (choice: none | guard | guard_one | guard_two): crew.rs
cycle_all = 1  # cycle: who gives the base something after filling up (choice: leader_and_guard | every_tank): cycle.rs
escort_distance = 4  # wingman: the station behind the leader, tiles
wing_leash = 20  # wingman: nothing takes it further than this from its leader, tiles
wing_greed = 16  # wingman: a pillbox or depot this near the leader is worth taking, tiles
wing_threat = 10  # wingman: anything hostile this near the leader is its first job, tiles
wing_ahead = 16  # wingman: it hits what is ahead of the leader within this, tiles
wing_stance = 0  # wingman: where its station is (choice: shadow | flank | screen): shadow behind the leader as built; flank off its side, each wingman its own side; screen ahead of it
